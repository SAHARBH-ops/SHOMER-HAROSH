<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    android:layoutDirection="rtl"
    tools:locale="he">

    <TextView
        android:id="@+id/app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="הכלי שלך להגנה מהונאות SMS ומיילים"
        android:textSize="16sp"
        android:textColor="#555555"
        android:layout_marginBottom="30dp" />

    <EditText
        android:id="@+id/license_key_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/license_key_hint"
        android:textSize="18sp"
        android:padding="12dp"
        android:background="@android:drawable/editbox_background"
        android:layout_marginBottom="20dp"
        android:inputType="text" />

    <Button
        android:id="@+id/btn_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_overlay"
        android:textSize="18sp"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#3B82F6"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btn_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_start"
        android:textSize="18sp"
        android:padding="16dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#10B981"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_unknown"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#666666" />

</LinearLayout>
